# Copiar como .env.production en la VM y usar secretos distintos a los del bot.
POSTGRES_DB=salas_uc
POSTGRES_USER=salas_uc_owner
POSTGRES_PASSWORD=GENERAR_UN_SECRETO_LARGO_Y_UNICO
JWT_SECRET=GENERAR_OTRO_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Solo se usa al ejecutar el seed inicial.
ADMIN_EMAIL=admin@uc.cl
ADMIN_PASSWORD=CAMBIAR_POR_UNA_PASSWORD_UNICA

# Nginx y el frontend comparten origen; normalmente debe quedar vacío.
# Para varios orígenes, separar por comas.
CORS_ORIGIN=

# Límites ajustables después de auditar la capacidad real de la VM.
DB_MEMORY_LIMIT=512m
DB_CPU_LIMIT=0.50
API_MEMORY_LIMIT=384m
API_CPU_LIMIT=0.50
API_HOST_PORT=3000
